{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remise",
  "version": "0.3.0",
  "identifier": "tools.remise.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Remise",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local file tools: PDF, image, video, audio, archives.",
    "category": "Utility"
  }
}
